<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      NOTE: android.permission.INTERNET is deliberately NOT declared and must never be
      added. The app is structurally incapable of network access, which is the strongest
      possible evidence for the "fully offline" requirement (PRD section 9.1).
      Language packs are provisioned by file copy, not by download from inside the app.
    -->

    <!-- Phase 3: microphone capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Phase 2: Bluetooth RFCOMM, API 31+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Phase 2: Bluetooth RFCOMM, API 30 and below -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Phase 4: raise volume for DISTRESS playback -->
    <!-- BLE broadcast mesh (BleMeshTransport). ADVERTISE is what lets this phone act as
         a relay rather than only a listener. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Before Android 12 a BLE scan required a location permission, because nearby
         beacons reveal where you are. Nothing here reads or sends location; the
         permission is capped to old versions so modern installs never ask for it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Wi-Fi broadcast bearer (WifiMulticastTransport).
         INTERNET is required by Android for ANY socket, including a purely local
         multicast one — there is no local-only alternative. It does NOT mean the app
         talks to a server: nothing here resolves a hostname or leaves the subnet, the
         destination is a 239.x administratively-scoped group, and the datagrams carry a
         TTL of 1 so a router will not forward them onward.

         The BLE bearer needs none of this and remains available when that distinction
         matters. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android drops multicast in the Wi-Fi driver unless a MulticastLock is held. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".ITantraApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ITantra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.ITantra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares only the measurements CSV (PRD F-51). Not exported, and scoped to
             one cache subdirectory, so nothing else the app stores is reachable. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
